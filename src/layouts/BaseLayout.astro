---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Scenes from '../components/Scenes.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../data/site';
import { sceneForPath } from '../data/scenes.mjs';
import ConsentBanner from '../components/ConsentBanner.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  datePublished?: Date;
  dateModified?: Date;
  breadcrumbs?: { name: string; path: string }[];
  /** Article pages only: the text sits on a solid panel so the background never runs behind it. */
  reading?: boolean;
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  datePublished,
  dateModified,
  breadcrumbs,
  reading = false,
} = Astro.props;
const scene = sceneForPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-page-scene={scene}>
  <head>
    <!-- Google Consent Mode: until the visitor chooses, Google Analytics may not set cookies. A choice saved on
         this device (gx-consent in localStorage) is applied at once, before the tag loads. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      var gxConsent = null;
      try { gxConsent = localStorage.getItem('gx-consent'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: gxConsent === 'granted' ? 'granted' : 'denied',
        wait_for_update: 500
      });
    </script>
    <!-- Google Analytics 4 (measurement ID G-NC7DCQ7KT1), loaded directly. It must stay after the consent defaults above,
         so that analytics cookies stay off until the visitor accepts. Load it once per page. -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NC7DCQ7KT1"></script>
    <script is:inline>
      gtag('js', new Date());
      gtag('config', 'G-NC7DCQ7KT1');
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Lets the styles tell "JavaScript is on" (the menu collapses into a burger) from "off" (every link stays visible).
      document.documentElement.setAttribute('data-js', '');
      try {
        // A light or dark choice saved by the switch is applied before the first paint; with no choice, the device decides.
        const theme = localStorage.getItem('gx-theme');
        if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme;
        // The page decides which scene it gets; a visitor can only switch the background off (saved as 'plain').
        const page = document.documentElement.dataset.pageScene;
        document.documentElement.dataset.scene = localStorage.getItem('gx-scene') === 'plain' ? 'plain' : page;
      } catch (e) {
        document.documentElement.dataset.scene = document.documentElement.dataset.pageScene;
      }
    </script>
    <!-- Fonts are served from this site (see public/fonts), never from a font service. -->
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chakra-petch-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <JsonLd
      title={title}
      description={description}
      image={image}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-surface text-ink antialiased"
  >
    <Scenes scene={scene} />
    <Header />
    <main class:list={["flex-1", { "gx-reading": reading }]} data-pagefind-body>
      <slot />
    </main>
    <Footer />
    <ConsentBanner />
  </body>
</html>
