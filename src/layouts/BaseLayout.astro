---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Scenes from '../components/Scenes.astro';
import SEO from '../components/SEO.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE_NAME, SITE_DESCRIPTION } from '../data/site';
import { sceneForPath } from '../data/scenes.mjs';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  datePublished?: Date;
  dateModified?: Date;
  breadcrumbs?: { name: string; path: string }[];
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  image,
  imageAlt,
  type = 'website',
  datePublished,
  dateModified,
  breadcrumbs,
} = Astro.props;
const scene = sceneForPath(Astro.url.pathname);
---

<!doctype html>
<html lang="en" data-page-scene={scene}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Lets the styles tell "JavaScript is on" (the menu collapses into a burger) from "off" (every link stays visible).
      document.documentElement.setAttribute('data-js', '');
      try {
        // The site follows the device's light/dark setting. A theme saved by the old toggle is forgotten, so nobody
        // stays stuck on a choice they can no longer change.
        localStorage.removeItem('gx-theme');
        // The page decides which scene it gets; a visitor can only switch the background off (saved as 'plain').
        const page = document.documentElement.dataset.pageScene;
        document.documentElement.dataset.scene = localStorage.getItem('gx-scene') === 'plain' ? 'plain' : page;
      } catch (e) {
        document.documentElement.dataset.scene = document.documentElement.dataset.pageScene;
      }
    </script>
    <!-- Fonts are served from this site (see public/fonts), never from a font service. -->
    <link rel="preload" href="/fonts/inter-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/chakra-petch-latin-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
    />
    <JsonLd
      title={title}
      description={description}
      image={image}
      type={type}
      datePublished={datePublished}
      dateModified={dateModified}
      breadcrumbs={breadcrumbs}
    />
  </head>
  <body
    class="flex min-h-screen flex-col bg-surface text-ink antialiased"
  >
    <Scenes scene={scene} />
    <Header />
    <main class="flex-1" data-pagefind-body>
      <slot />
    </main>
    <Footer />
  </body>
</html>
