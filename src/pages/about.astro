---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'GamersXpress covers PC, console, hardware and esports news with a focus on India. Learn what we publish and how the site works.';
---

<BaseLayout
  title="About | GamersXpress"
  description={description}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: 'About', path: '/about' },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight">About GamersXpress</h1>
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">
      GamersXpress is a gaming news site covering PC, console, hardware and
      esports, with a focus on India.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">What we cover</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      Gaming news, PC and console hardware, PlayStation, Xbox, Nintendo, gaming
      technology, esports, and the Indian gaming and esports scene — releases,
      patches, hardware launches, and competitive events.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">How we work</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      Stories are based on official announcements and reputable sources.
      Claims are checked against the sources cited in the article, rumors are
      labeled as rumors, and every article links the sources it was built
      from. See our
      <a
        href="/editorial-policy"
        class="text-sky-600 underline underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
        >editorial policy</a
      >
      and
      <a
        href="/ai-disclosure"
        class="text-sky-600 underline underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
        >AI disclosure</a
      >
      for the details.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">Corrections</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      If something is wrong, we fix it and the article shows an Updated date.
      Read
      <a
        href="/corrections"
        class="text-sky-600 underline underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
        >how to report an error</a
      >.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">Contact</h2>
    <p class="mt-3 text-slate-600 dark:text-slate-300">
      Questions, tips, or feedback? Visit the
      <a
        href="/contact"
        class="text-sky-600 underline underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
        >contact page</a
      >.
    </p>
  </article>
</BaseLayout>
