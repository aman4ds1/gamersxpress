---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORIES, CATEGORY_LABELS, type Category } from '../../data/categories';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return CATEGORIES.map((category) => ({
    params: { category },
    props: {
      category,
      articles: articles
        .filter((article) => article.data.category === category)
        .sort(
          (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
        ),
    },
  }));
}

interface Props {
  category: Category;
  articles: CollectionEntry<'articles'>[];
}

const { category, articles } = Astro.props;
const label = CATEGORY_LABELS[category];
---

<BaseLayout
  title={`${label} | GamersXpress`}
  description={`${label} coverage on GamersXpress: news, reviews, and analysis with sources you can verify.`}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: label, path: `/category/${category}` },
  ]}
>
  <div class="gx-wrap flex flex-col gap-8 pt-10 pb-20">
    <header class="gx-pagehead">
      <span class="gx-eyebrow">Category</span>
      <h1>{label}</h1>
      <p>{articles.length} {articles.length === 1 ? 'story' : 'stories'}, newest first. Every story links its sources.</p>
    </header>
    {
      articles.length > 0 ? (
        <div class="gx-grid">{articles.map((article) => <ArticleCard article={article} level={2} />)}</div>
      ) : (
        <p class="text-ink-muted">New {label} articles are coming soon.</p>
      )
    }
  </div>
</BaseLayout>
