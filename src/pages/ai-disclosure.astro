---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'GamersXpress articles are produced with AI assistance and checked against the cited sources before they are published.';
---

<BaseLayout
  title="AI Disclosure | GamersXpress"
  description={description}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: 'AI Disclosure', path: '/ai-disclosure' },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight">AI disclosure</h1>
    <p class="mt-4 text-lg text-ink-muted">
      Articles on GamersXpress are produced with AI assistance and checked
      against the cited sources before they are published.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">How articles are made</h2>
    <p class="mt-3 text-ink-muted">
      Each article starts from a facts sheet extracted from the sources listed
      at the bottom of the page. The draft is written from that facts sheet,
      then checked claim by claim against the same sources. A claim that
      cannot be supported by a source is removed.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">What this means for you</h2>
    <p class="mt-3 text-ink-muted">
      AI tools help produce and check the text; the facts come from the
      sources. Every article links those sources, so you can read them
      yourself and judge the story directly.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">If something is wrong</h2>
    <p class="mt-3 text-ink-muted">
      AI assistance is not an excuse for errors. If you spot one, see
      <a
        href="/corrections"
        class="text-accent underline underline-offset-2 hover:text-accent-hover"
        >corrections</a
      >
      for how to report it. Our
      <a
        href="/editorial-policy"
        class="text-accent underline underline-offset-2 hover:text-accent-hover"
        >editorial policy</a
      >
      covers sourcing and how rumors are handled.
    </p>
  </article>
</BaseLayout>
