---
import BaseLayout from '../layouts/BaseLayout.astro';

const description =
  'GamersXpress uses AI tools to help write articles, which are checked against the sources they cite. Learn how we handle accuracy and corrections.';
---

<BaseLayout
  title="AI Disclosure | GamersXpress"
  description={description}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: 'AI Disclosure', path: '/ai-disclosure' },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight">AI disclosure</h1>
    <p class="mt-4 text-lg text-ink-muted">
      GamersXpress uses AI tools to help research and write articles. Every
      article is checked against the sources it cites before it is published.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">Our approach</h2>
    <p class="mt-3 text-ink-muted">
      AI helps with drafting; the facts come from the sources. Every article
      links those sources, so you can read them yourself. People oversee the
      process and handle corrections.
    </p>

    <h2 class="mt-8 text-xl font-bold tracking-tight">If something is wrong</h2>
    <p class="mt-3 text-ink-muted">
      AI assistance is not an excuse for errors. If you spot one, see
      <a href="/corrections" class="text-accent underline underline-offset-2 hover:text-accent-hover">corrections</a>
      for how to report it. Our
      <a href="/editorial-policy" class="text-accent underline underline-offset-2 hover:text-accent-hover">editorial policy</a>
      covers sourcing and how rumors are handled.
    </p>
  </article>
</BaseLayout>
