---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sprite from '../components/Sprite.astro';
import { CLOUD, COIN } from '../data/sprites';

const description = 'The page you were looking for could not be found on GamersXpress.';
---

<BaseLayout title="Page not found | GamersXpress" description={description} noindex>
  <div class="gx-wrap py-14">
    <section class="gx-panel gx-lost">
      <div class="gx-lost-art" aria-hidden="true">
        <Sprite sprite={CLOUD} size={90} class="gx-lost-cloud" />
        <Sprite sprite={COIN} size={30} class="gx-lost-coin" />
      </div>
      <p class="gx-eyebrow gx-lost-tag">Error 404</p>
      <h1 class="gx-lost-code gx-pixel">404</h1>
      <p class="gx-lost-title">Page not found</p>
      <p class="gx-muted gx-lost-copy">
        This page isn't here. It may have moved, or the link may have a typo. Try the latest stories or a search.
      </p>
      <p class="gx-lost-actions">
        <a href="/" class="gx-btn gx-btn-primary">Latest stories</a>
        <a href="/search" class="gx-btn gx-lost-search" id="gx-nc-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
          Search
        </a>
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  // Open the search popup, centered, instead of leaving for /search. Without JavaScript the link still works.
  document.getElementById('gx-nc-search')?.addEventListener('click', (event) => {
    const opener = document.getElementById('search-open');
    if (!opener) return;
    event.preventDefault();
    document.getElementById('gx-sp')?.setAttribute('data-center', '1');
    opener.click();
  });
</script>

<style>
  .gx-lost { position: relative; max-width: 720px; margin: 0 auto; padding: 44px clamp(22px, 5vw, 52px); overflow: hidden; text-align: left; }
  .gx-lost-art { position: absolute; top: 22px; right: 26px; display: flex; align-items: flex-end; gap: 10px; color: var(--a2); }
  .gx-lost-tag { color: var(--gx-blue-ink); }
  .gx-lost-code { margin-top: 10px; font-size: clamp(56px, 12vw, 104px); line-height: 1; color: var(--gx-panel-ink); text-shadow: 4px 4px 0 var(--gold); }
  .gx-lost-title { margin-top: 18px; font-family: 'Chakra Petch', var(--font-sans); font-size: clamp(24px, 3vw, 32px); font-weight: 700; color: var(--gx-panel-ink); }
  .gx-lost-copy { max-width: 520px; margin-top: 10px; font-size: 17px; line-height: 1.6; }
  .gx-lost-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 26px; }
  .gx-lost-search { border: 1px solid var(--gx-panel-line); background: #FFFFFF; color: var(--gx-panel-ink); }
  .gx-lost-search:hover { border-color: var(--gx-blue); }
  @media (max-width: 560px) { .gx-lost-art { display: none; } }
</style>
