---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import HeroStory from '../components/HeroStory.astro';
import SideStory from '../components/SideStory.astro';
import MostCovered from '../components/MostCovered.astro';
import TopicStrip from '../components/TopicStrip.astro';
import FollowBanner from '../components/FollowBanner.astro';
import { sortedArticles, topicCounts } from '../data/articles';
import type { Category } from '../data/categories';

// Everything on this page comes from the published articles, newest first; no story appears twice.
const all = await sortedArticles();
const top = all[0];
// a portrait or square top-story picture is shown whole, not cropped
const topImageClass = top?.data.hero && top.data.hero.width / top.data.hero.height < 1.2 ? 'gx-thumb-contain' : undefined;
const side = all.slice(1, 4);
// The Latest News grid continues after the featured stories; with few articles it shows what is left.
const latest = all.slice(1 + side.length, 1 + side.length + 6);
const topics = topicCounts(all).slice(0, 5);
const counts: Partial<Record<Category, number>> = {};
for (const article of all) counts[article.data.category] = (counts[article.data.category] ?? 0) + 1;
---

<BaseLayout title="GamersXpress | Gaming News, Hardware & Esports">
  <div class="gx-wrap gx-home">
    <h1 class="sr-only">GamersXpress: gaming news that checks out</h1>
    {
      top ? (
        <section class:list={['gx-top', side.length === 0 && 'gx-top-solo']} aria-label="Top stories">
          <HeroStory article={top} imageClass={topImageClass} />
          {side.length > 0 && (
            <div class="gx-sides">
              {side.map((article) => <SideStory article={article} />)}
            </div>
          )}
        </section>
      ) : (
        <p class="text-ink-muted">New articles are coming soon.</p>
      )
    }

    {
      (latest.length > 0 || topics.length > 0) && (
        <div class:list={['gx-midrow', (latest.length === 0 || topics.length === 0) && 'gx-midrow-solo']}>
          {latest.length > 0 && (
            <section class="gx-panel gx-latest" aria-labelledby="latest-heading">
              <div class="gx-latest-head">
                <h2 id="latest-heading" class="gx-panel-title">Latest News</h2>
                <span class="gx-rule" aria-hidden="true" />
                <a href="/news" class="gx-viewall">
                  View all news
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </a>
              </div>
              <div class="gx-grid">{latest.map((article) => <ArticleCard article={article} />)}</div>
            </section>
          )}
          {topics.length > 0 && <MostCovered topics={topics} />}
        </div>
      )
    }

    <TopicStrip counts={counts} />
    <FollowBanner />
  </div>
</BaseLayout>
