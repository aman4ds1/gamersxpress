---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { CATEGORY_LABELS } from '../data/categories';

const latest = (await getCollection('articles'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 10);
---

<BaseLayout title="GamersXpress — Gaming News, Hardware & Esports">
  <section class="border-b border-line">
    <div class="mx-auto max-w-6xl px-4 py-14 text-center">
      <h1 class="text-3xl font-extrabold tracking-tight sm:text-4xl">
        Gaming news that checks out
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-base text-ink-muted sm:text-lg">
        PC, PlayStation, Xbox, Nintendo, hardware, and esports coverage with
        sources you can verify.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10" aria-labelledby="latest-articles">
    <h2 id="latest-articles" class="text-2xl font-bold tracking-tight">
      Latest articles
    </h2>
    {
      latest.length > 0 ? (
        <ul class="mt-6 space-y-8">
          {latest.map((article) => (
            <li>
              <article>
                <p class="text-sm text-ink-subtle">
                  <time datetime={article.data.pubDate.toISOString()}>
                    {article.data.pubDate.toLocaleDateString('en-US', {
                      year: 'numeric',
                      month: 'long',
                      day: 'numeric',
                    })}
                  </time>
                  {' · '}
                  <a
                    href={`/category/${article.data.category}`}
                    class="hover:text-ink-brand"
                  >
                    {CATEGORY_LABELS[article.data.category]}
                  </a>
                </p>
                <h3 class="mt-1 text-xl font-bold tracking-tight">
                  <a
                    href={`/news/${article.id}`}
                    class="hover:text-accent"
                  >
                    {article.data.title}
                  </a>
                </h3>
                <p class="mt-2 text-ink-muted">
                  {article.data.description}
                </p>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <div class="mt-6 rounded-sm border border-dashed border-line-strong p-10 text-center text-sm text-ink-subtle">
          Latest articles will appear here.
        </div>
      )
    }
  </section>
</BaseLayout>
