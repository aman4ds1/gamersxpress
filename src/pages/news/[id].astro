---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS, chipStyle } from '../../data/categories';
import { entitySlug } from '../../data/entities';
import { formatDate, readingMinutes, relatedArticles, sortedArticles } from '../../data/articles';
import { ADS_ENABLED } from '../../data/ads';
import AdSlot from '../../components/AdSlot.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ShareLinks from '../../components/ShareLinks.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, category, sources, image, imageAlt, hero } =
  article.data;
const categoryLabel = CATEGORY_LABELS[category];
const topicLinks = article.data.entities
  .map((entity) => ({ entity, slug: entitySlug(entity) }))
  .filter(({ slug }) => slug);
const minutes = readingMinutes(article.body);
const related = relatedArticles(article, await sortedArticles(), 3);
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<BaseLayout
  reading
  title={`${title} | GamersXpress`}
  description={description}
  image={hero?.src ?? image}
  imageAlt={hero?.alt ?? imageAlt}
  type="article"
  datePublished={pubDate}
  dateModified={updatedDate}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: categoryLabel, path: `/category/${category}` },
    { name: title, path: `/news/${article.id}` },
  ]}
>
  <ReadingProgress />
  <div class:list={['gx-article-wrap', ADS_ENABLED && 'lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-10']}>
    <article class="mx-auto w-full max-w-[760px]">
      <!-- Marks this page as an article for the search popup, which lists articles only (no topic or category pages). -->
      <span hidden data-pagefind-filter="type[data-value]" data-value="article"></span>
      <nav aria-label="Breadcrumb" class="gx-crumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li><a href={`/category/${category}`}>{categoryLabel}</a></li>
          <li aria-current="page"><span>{title}</span></li>
        </ol>
      </nav>
      <header class="mt-5 flex flex-col items-start gap-4">
        <span class="gx-chip" style={chipStyle(category)}>{categoryLabel}</span>
        <h1 class="gx-display text-[clamp(30px,4.6vw,50px)] leading-[1.06] font-bold text-ink text-balance">{title}</h1>
        <p class="text-lg leading-relaxed text-ink-muted">{description}</p>
        <p class="gx-meta gx-article-meta">
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            {
              updatedDate && (
                <>
                  {' · Updated '}
                  <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
                </>
              )
            }
          </span>
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21a8 8 0 0 1 16 0"></path></svg>
            <span>By <a href="/ai-disclosure">GamersXpress Newsroom</a></span>
          </span>
          <span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
            {minutes} min read
          </span>
        </p>
        {
          topicLinks.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Topics">
              {topicLinks.map(({ entity, slug }) => (
                <li>
                  <a href={`/topic/${slug}`} class="gx-topic">{entity}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>

      {
        hero && (
          <figure class="mt-8">
            <div class="gx-heroframe">
              <img
                src={hero.src}
                alt={hero.alt}
                width={hero.width}
                height={hero.height}
                fetchpriority="high"
                decoding="async"
              />
            </div>
            <figcaption class="gx-mono mt-2 text-[11px] tracking-wider text-ink-muted">
              Image:{' '}
              {hero.title && <>“{hero.title}” by{' '}</>}
              {
                hero.sourceUrl ? (
                  <a href={hero.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-ink">
                    {hero.credit}
                  </a>
                ) : (
                  hero.credit
                )
              }
              {' · '}
              {
                hero.licenseUrl ? (
                  <a href={hero.licenseUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-ink">
                    {hero.license}
                  </a>
                ) : (
                  hero.license
                )
              }
            </figcaption>
          </figure>
        )
      }

      <AdSlot name="article-top" width={728} height={90} variant="article-top" />

      <div class="article-body mt-8">
        <Content />
        <AdSlot name="article-inline" width={336} height={280} variant="article-inline" />
      </div>

      <section class="mt-12 border-t border-line pt-6" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="gx-eyebrow">Sources</h2>
        <ol class="gx-sources mt-2 list-decimal pl-6 text-ink-muted">
          {
            sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--link)] underline underline-offset-4 hover:text-[var(--accent-hover)]">{source.name}</a>
              </li>
            ))
          }
        </ol>
      </section>

      <div class="mt-8 border-t border-line pt-6">
        <ShareLinks url={pageUrl} title={title} />
      </div>
    </article>
    {
      ADS_ENABLED && (
        <aside class="hidden lg:block" aria-label="Sidebar">
          <AdSlot name="article-sidebar" width={300} height={600} variant="sidebar" />
        </aside>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section class="gx-related" aria-labelledby="related-heading">
        <h2 id="related-heading" class="gx-panel-title">Related stories</h2>
        <div class="gx-grid mt-4">{related.map((other) => <ArticleCard article={other} />)}</div>
      </section>
    )
  }
</BaseLayout>
