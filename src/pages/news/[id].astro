---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_COLORS, CATEGORY_LABELS } from '../../data/categories';
import { entitySlug } from '../../data/entities';
import { ADS_ENABLED } from '../../data/ads';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, category, sources, image, imageAlt } =
  article.data;
const categoryLabel = CATEGORY_LABELS[category];
const topicLinks = article.data.entities
  .map((entity) => ({ entity, slug: entitySlug(entity) }))
  .filter(({ slug }) => slug);
---

<BaseLayout
  title={`${title} | GamersXpress`}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  datePublished={pubDate}
  dateModified={updatedDate}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: categoryLabel, path: `/category/${category}` },
    { name: title, path: `/news/${article.id}` },
  ]}
>
  <div class:list={['gx-wrap pt-10 pb-24', ADS_ENABLED && 'lg:grid lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-10']}>
    <article class="mx-auto w-full max-w-[780px]">
      <a href={`/category/${category}`} class="gx-mono text-xs tracking-[0.16em] text-ink-muted no-underline hover:text-ink">◂ {categoryLabel.toUpperCase()}</a>
      <header class="mt-6 flex flex-col items-start gap-4">
        <span class="gx-chip" style={`--chip:${CATEGORY_COLORS[category]}`}>{categoryLabel}</span>
        <h1 class="gx-display text-[clamp(30px,4.6vw,52px)] leading-[1.06] font-bold text-ink">{title}</h1>
        <p class="text-lg leading-relaxed text-ink-muted">{description}</p>
        <p class="gx-mono text-xs tracking-wider text-ink-muted">
          <time datetime={pubDate.toISOString()}>
            {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          {
            updatedDate && (
              <>
                {' · Updated '}
                <time datetime={updatedDate.toISOString()}>
                  {updatedDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
                </time>
              </>
            )
          }
        </p>
        {
          topicLinks.length > 0 && (
            <ul class="flex flex-wrap gap-2" aria-label="Topics">
              {topicLinks.map(({ entity, slug }) => (
                <li>
                  <a href={`/topic/${slug}`} class="gx-topic">{entity}</a>
                </li>
              ))}
            </ul>
          )
        }
      </header>
      <span class="gx-gradbar mt-8 block h-[3px] w-[72px] rounded-sm" aria-hidden="true"></span>

      <AdSlot name="article-top" width={728} height={90} variant="article-top" />

      <div class="article-body mt-8">
        <Content />
        <AdSlot name="article-inline" width={336} height={280} variant="article-inline" />
      </div>

      <section class="mt-14 border-t border-line pt-6" aria-labelledby="sources-heading">
        <h2 id="sources-heading" class="gx-mono gx-grad text-xs font-bold tracking-[0.2em]">// SOURCES</h2>
        <ol class="mt-3 list-decimal space-y-1.5 pl-6 text-ink-muted">
          {
            sources.map((source) => (
              <li>
                <a href={source.url} target="_blank" rel="noopener noreferrer" class="text-[var(--link)] underline underline-offset-4 hover:text-[var(--accent-hover)]">{source.name}</a>
              </li>
            ))
          }
        </ol>
      </section>
    </article>
    {
      ADS_ENABLED && (
        <aside class="hidden lg:block" aria-label="Sidebar">
          <AdSlot name="article-sidebar" width={300} height={600} variant="sidebar" />
        </aside>
      )
    }
  </div>
</BaseLayout>
