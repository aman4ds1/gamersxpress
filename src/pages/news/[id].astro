---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../../data/categories';
import { entitySlug } from '../../data/entities';
import { ADS_ENABLED } from '../../data/ads';
import AdSlot from '../../components/AdSlot.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, category, sources, image, imageAlt } =
  article.data;
const categoryLabel = CATEGORY_LABELS[category];
const topicLinks = article.data.entities
  .map((entity) => ({ entity, slug: entitySlug(entity) }))
  .filter(({ slug }) => slug);
---

<BaseLayout
  title={`${title} | GamersXpress`}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  datePublished={pubDate}
  dateModified={updatedDate}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: categoryLabel, path: `/category/${category}` },
    { name: title, path: `/news/${article.id}` },
  ]}
>
  <article
    class={ADS_ENABLED
      ? 'mx-auto grid max-w-6xl gap-8 px-4 py-10 lg:grid-cols-[minmax(0,1fr)_300px]'
      : 'mx-auto max-w-3xl px-4 py-10'}
  >
    <div class={ADS_ENABLED ? 'min-w-0' : undefined}>
      <p class="text-sm text-ink-subtle">
        <time datetime={pubDate.toISOString()}>
          {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </time>
        {' · '}
        <a
          href={`/category/${category}`}
          class="hover:text-ink-brand"
        >
          {categoryLabel}
        </a>
      </p>
      <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
        {title}
      </h1>
      {
        updatedDate && (
          <p class="mt-2 text-sm text-ink-subtle">
            Updated{' '}
            <time datetime={updatedDate.toISOString()}>
              {updatedDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
          </p>
        )
      }
      <p class="mt-4 text-lg text-ink-muted">{description}</p>

      {
        topicLinks.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2" aria-label="Topics">
            {topicLinks.map(({ entity, slug }) => (
              <li>
                <a
                  href={`/topic/${slug}`}
                  class="inline-block rounded-sm border border-line-strong px-2.5 py-1 text-xs font-medium text-ink-muted hover:border-line-hover hover:text-ink-strong"
                >
                  {entity}
                </a>
              </li>
            ))}
          </ul>
        )
      }

      <AdSlot name="article-top" width={728} height={90} variant="article-top" />

      <div class="article-body mt-8">
        <Content />
        <AdSlot name="article-inline" width={336} height={280} variant="article-inline" />
      </div>

      <section
        class="mt-10 border-t border-line pt-6"
        aria-labelledby="sources-heading"
      >
        <h2
          id="sources-heading"
          class="text-xl font-bold tracking-tight"
        >
          Sources
        </h2>
        <ol class="mt-3 list-decimal space-y-2 pl-6 text-sm">
          {
            sources.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-accent underline underline-offset-2 hover:text-accent-hover"
                >
                  {source.name}
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
    {
      ADS_ENABLED && (
        <aside class="hidden lg:block" aria-label="Sidebar">
          <AdSlot name="article-sidebar" width={300} height={600} variant="sidebar" />
        </aside>
      )
    }
  </article>
</BaseLayout>
