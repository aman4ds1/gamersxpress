---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../../data/categories';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { Content } = await render(article);
const { title, description, pubDate, updatedDate, category, sources, image, imageAlt } =
  article.data;
const categoryLabel = CATEGORY_LABELS[category];
---

<BaseLayout
  title={`${title} | GamersXpress`}
  description={description}
  image={image}
  imageAlt={imageAlt}
  type="article"
  datePublished={pubDate}
  dateModified={updatedDate}
  breadcrumbs={[
    { name: 'GamersXpress', path: '/' },
    { name: categoryLabel, path: `/category/${category}` },
    { name: title, path: `/news/${article.id}` },
  ]}
>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-sm text-slate-500 dark:text-slate-400">
      <time datetime={pubDate.toISOString()}>
        {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
      </time>
      {' · '}
      <a
        href={`/category/${category}`}
        class="hover:text-slate-900 dark:hover:text-white"
      >
        {categoryLabel}
      </a>
    </p>
    <h1 class="mt-2 text-3xl font-extrabold tracking-tight sm:text-4xl">
      {title}
    </h1>
    {
      updatedDate && (
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          Updated{' '}
          <time datetime={updatedDate.toISOString()}>
            {updatedDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
        </p>
      )
    }
    <p class="mt-4 text-lg text-slate-600 dark:text-slate-300">{description}</p>

    <div class="article-body mt-8">
      <Content />
    </div>

    <section
      class="mt-10 border-t border-slate-200 pt-6 dark:border-slate-800"
      aria-labelledby="sources-heading"
    >
      <h2
        id="sources-heading"
        class="text-xl font-bold tracking-tight"
      >
        Sources
      </h2>
      <ol class="mt-3 list-decimal space-y-2 pl-6 text-sm">
        {
          sources.map((source) => (
            <li>
              <a
                href={source.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sky-600 underline underline-offset-2 hover:text-sky-500 dark:text-sky-400 dark:hover:text-sky-300"
              >
                {source.name}
              </a>
            </li>
          ))
        }
      </ol>
    </section>
  </article>
</BaseLayout>
