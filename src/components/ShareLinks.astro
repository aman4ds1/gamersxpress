---
/**
 * Share this article: copy its link, or open a share page on X or Reddit. Plain links built at build time; no
 * third-party scripts or widgets, and nothing is loaded from those sites until a visitor clicks.
 */
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
const x = `https://x.com/intent/post?${new URLSearchParams({ url, text: title })}`;
const reddit = `https://www.reddit.com/submit?${new URLSearchParams({ url, title })}`;
---

<div class="gx-share" aria-label="Share this article" role="group">
  <span class="gx-share-label">Share</span>
  <button type="button" class="gx-sharebtn" data-copy-link={url}>
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1"></path><path d="M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1"></path></svg>
    <span data-copy-label>Copy link</span>
  </button>
  <a class="gx-sharebtn" href={x} target="_blank" rel="noopener noreferrer">X</a>
  <a class="gx-sharebtn" href={reddit} target="_blank" rel="noopener noreferrer">Reddit</a>
  <span class="sr-only" role="status" data-copy-status></span>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      const status = button.parentElement?.querySelector('[data-copy-status]');
      let text = 'Link copied';
      try {
        await navigator.clipboard.writeText(button.dataset.copyLink ?? location.href);
      } catch (e) {
        text = 'Copy failed';
      }
      if (label) label.textContent = text;
      if (status) status.textContent = text;
      setTimeout(() => {
        if (label) label.textContent = 'Copy link';
      }, 2000);
    });
  });
</script>
