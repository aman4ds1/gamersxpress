---
import PixelLogo from './PixelLogo.astro';

const year = new Date().getFullYear();
const footerLinks = [
  { label: 'About', href: '/about' },
  { label: 'Editorial Policy', href: '/editorial-policy' },
  { label: 'AI Disclosure', href: '/ai-disclosure' },
  { label: 'Corrections', href: '/corrections' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer class="gx-footer mt-auto">
  <div class="gx-wrap flex flex-wrap items-center justify-between gap-5 py-8 text-sm text-ink-muted">
    <span class="flex items-center gap-2.5">
      <PixelLogo width={30} animated={false} />
      <span class="gx-pixel text-[11px] text-ink">GAMERS<span style="color: var(--gold)">X</span>PRESS</span>
    </span>
    <nav aria-label="Footer">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {footerLinks.map((item) => <li><a href={item.href} class="hover:text-ink">{item.label}</a></li>)}
      </ul>
    </nav>
    <span>&copy; {year} GamersXpress</span>
  </div>
</footer>
