---
const year = new Date().getFullYear();
const footerLinks = [
  { label: 'About', href: '/about' },
  { label: 'Editorial Policy', href: '/editorial-policy' },
  { label: 'AI Disclosure', href: '/ai-disclosure' },
  { label: 'Corrections', href: '/corrections' },
  { label: 'Contact', href: '/contact' },
  { label: 'Privacy', href: '/privacy' },
];
---

<footer class="border-t border-line bg-surface">
  <div class="mx-auto max-w-6xl px-4 py-6 text-sm text-ink-subtle">
    <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {year} GamersXpress. All rights reserved.</p>
      <p>Gaming news, hardware, and esports coverage.</p>
    </div>
    <nav aria-label="Footer" class="mt-4">
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        {
          footerLinks.map((item) => (
            <li>
              <a
                href={item.href}
                class="transition-colors hover:text-ink-brand"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>
