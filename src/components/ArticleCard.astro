---
/** A story card: picture with its category tag, title, short description, date and reading time. Always light. */
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS, chipStyle } from '../data/categories';
import { cardImage, readingMinutes } from '../data/articles';
import Meta from './Meta.astro';

interface Props {
  article: CollectionEntry<'articles'>;
  /** 2 on listing pages, where the cards sit right under the page's h1; 3 (default) under a section heading. */
  level?: 2 | 3;
}

const { article, level = 3 } = Astro.props;
const Heading = level === 2 ? 'h2' : 'h3';
const { title, description, pubDate, category } = article.data;
const image = cardImage(article);
// a portrait or square picture is shown whole, not cropped to 16:9
const { hero } = article.data;
const contain = hero ? hero.width / hero.height < 1.2 : false;
---

<a href={`/news/${article.id}`} class="gx-lined gx-ncard">
  <article class="gx-ncard-inner">
    <div class="gx-ncard-media">
      <img
        src={image.src}
        alt=""
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
        class:list={[contain && 'gx-thumb-contain']}
      />
      <span class="gx-chip gx-ncard-chip" style={chipStyle(category)}>{CATEGORY_LABELS[category]}</span>
    </div>
    <div class="gx-ncard-body">
      <Heading class="gx-ncard-title">{title}</Heading>
      <p class="gx-ncard-desc">{description}</p>
      <Meta date={pubDate} minutes={readingMinutes(article.body)} class="mt-auto" />
    </div>
  </article>
</a>
