---
// Search in place: a popup that opens right under the search button in the header, so the visitor never leaves
// the page. It uses the same Pagefind index as /search (built into dist/pagefind), loaded the first time it opens.
// It sits OUTSIDE the <header>: the header has a backdrop-filter, which would make position: fixed relative to it.
---

<div class="gx-sp-backdrop" id="gx-sp-backdrop" hidden></div>
<div class="gx-sp" id="gx-sp" role="dialog" aria-label="Search articles" hidden>
  <form class="gx-sp-box" role="search" onsubmit="return false">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
    <input
      id="gx-sp-input"
      class="gx-sp-input"
      type="search"
      role="combobox"
      aria-label="Search articles"
      aria-expanded="false"
      aria-controls="gx-sp-list"
      aria-autocomplete="list"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      placeholder="Search articles: try NVIDIA, PS5, esports…"
    />
    <button type="button" class="gx-sp-close" id="gx-sp-close" aria-label="Close search">Esc</button>
  </form>
  <p class="gx-sp-status" id="gx-sp-status" role="status" aria-live="polite"></p>
  <ul class="gx-sp-list" id="gx-sp-list" role="listbox" aria-label="Search results"></ul>
</div>

<script>
  const MAX_RESULTS = 8;
  const opener = document.getElementById('search-open') as HTMLButtonElement | null;
  const panel = document.getElementById('gx-sp') as HTMLElement | null;
  const backdrop = document.getElementById('gx-sp-backdrop') as HTMLElement | null;
  const input = document.getElementById('gx-sp-input') as HTMLInputElement | null;
  const closeButton = document.getElementById('gx-sp-close') as HTMLButtonElement | null;
  const status = document.getElementById('gx-sp-status') as HTMLElement | null;
  const list = document.getElementById('gx-sp-list') as HTMLElement | null;

  type Hit = { url: string; title: string; excerpt: string };

  if (opener && panel && backdrop && input && closeButton && status && list) {
    let pagefind: any = null;
    let articlesOnly = false; // true when the index can tell articles from topic and category pages
    let loading: Promise<boolean> | null = null;
    let hits: Hit[] = [];
    let active = -1;
    let token = 0;
    let frame = 0;

    // The index is only fetched the first time the popup opens.
    const loadIndex = (): Promise<boolean> => {
      if (pagefind) return Promise.resolve(true);
      loading ??= (async () => {
        try {
          const url = '/pagefind/pagefind.js';
          pagefind = await import(/* @vite-ignore */ url);
          await pagefind.init();
          const filters = await pagefind.filters();
          articlesOnly = Number(filters?.type?.article ?? 0) > 0;
          return true;
        } catch {
          loading = null;
          return false;
        }
      })();
      return loading;
    };

    const isOpen = () => !panel.hidden;

    // Pagefind's excerpt is HTML with <mark> around the matches. Only those marks are kept; everything else is text.
    const decoder = document.createElement('textarea');
    const decode = (html: string) => {
      decoder.innerHTML = html;
      return decoder.value;
    };
    const fillExcerpt = (target: HTMLElement, html: string) => {
      let marked = false;
      for (const part of html.split(/(<\/?mark>)/)) {
        if (part === '<mark>') marked = true;
        else if (part === '</mark>') marked = false;
        else if (part) {
          const text = decode(part.replace(/<[^>]*>/g, ''));
          if (marked) {
            const mark = document.createElement('mark');
            mark.textContent = text;
            target.append(mark);
          } else {
            target.append(text);
          }
        }
      }
    };

    const setStatus = (text: string) => {
      status.textContent = text;
    };

    const setActive = (index: number) => {
      active = index;
      list.querySelectorAll('[role="option"]').forEach((option, position) => {
        option.setAttribute('aria-selected', String(position === index));
        if (position === index) (option as HTMLElement).scrollIntoView({ block: 'nearest' });
      });
      if (index >= 0) input.setAttribute('aria-activedescendant', `gx-sp-opt-${index}`);
      else input.removeAttribute('aria-activedescendant');
    };

    const show = (found: Hit[], query: string) => {
      hits = found;
      list.replaceChildren();
      found.forEach((hit, index) => {
        const item = document.createElement('li');
        item.id = `gx-sp-opt-${index}`;
        item.className = 'gx-sp-item';
        item.setAttribute('role', 'option');
        item.setAttribute('aria-selected', 'false');
        const link = document.createElement('a');
        link.href = hit.url;
        link.tabIndex = -1;
        const title = document.createElement('span');
        title.className = 'gx-sp-title';
        title.textContent = hit.title;
        const excerpt = document.createElement('span');
        excerpt.className = 'gx-sp-excerpt';
        fillExcerpt(excerpt, hit.excerpt);
        link.append(title, excerpt);
        item.append(link);
        item.addEventListener('pointermove', () => active !== index && setActive(index));
        list.append(item);
      });
      input.setAttribute('aria-expanded', String(found.length > 0));
      setActive(found.length > 0 ? 0 : -1);
      setStatus(
        found.length === 0
          ? `No results for “${query}”.`
          : `${found.length} result${found.length === 1 ? '' : 's'}. Use the arrow keys, then Enter.`,
      );
    };

    const clear = () => {
      hits = [];
      list.replaceChildren();
      input.setAttribute('aria-expanded', 'false');
      setActive(-1);
    };

    const run = async (query: string) => {
      const mine = ++token;
      if (!query) {
        clear();
        setStatus('Type to search articles.');
        return;
      }
      setStatus('Searching…');
      const ready = await loadIndex();
      if (mine !== token) return;
      if (!ready) {
        clear();
        setStatus('Search is not available yet. It is created when the site is built.');
        return;
      }
      // Articles first: the popup lists articles, not the topic and category pages that Pagefind also indexes. If a
      // word only appears on such a page (a topic with no article yet), search everything instead of showing nothing.
      let found = await pagefind.debouncedSearch(query, articlesOnly ? { filters: { type: 'article' } } : {}, 120);
      if (found === null || mine !== token) return; // a newer search replaced this one
      if (articlesOnly && found.results.length === 0) {
        found = await pagefind.debouncedSearch(query, {}, 120);
        if (found === null || mine !== token) return;
      }
      const data = await Promise.all(found.results.slice(0, MAX_RESULTS).map((result: any) => result.data()));
      if (mine !== token) return;
      show(
        data.map((item: any) => ({ url: item.url, title: item.meta?.title || item.url, excerpt: item.excerpt || '' })),
        query,
      );
    };

    // The popup sits right under the search button (right edges aligned), and stays inside the screen.
    const place = () => {
      const box = opener.getBoundingClientRect();
      const width = Math.min(600, window.innerWidth - 24);
      const top = box.bottom + 10;
      const right = Math.min(Math.max(12, window.innerWidth - box.right), window.innerWidth - width - 12);
      panel.style.width = `${width}px`;
      panel.style.top = `${top}px`;
      panel.style.right = `${right}px`;
      panel.style.maxHeight = `${Math.max(220, window.innerHeight - top - 16)}px`;
    };
    const replace = () => {
      if (!isOpen() || frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        place();
      });
    };

    const open = () => {
      if (isOpen()) return;
      place();
      panel.hidden = false;
      backdrop.hidden = false;
      opener.setAttribute('aria-expanded', 'true');
      document.dispatchEvent(new CustomEvent('gx-overlay', { detail: 'search' }));
      input.focus();
      input.select();
      void run(input.value.trim());
    };
    const close = (returnFocus = true) => {
      if (!isOpen()) return;
      token += 1;
      panel.hidden = true;
      backdrop.hidden = true;
      opener.setAttribute('aria-expanded', 'false');
      if (returnFocus) opener.focus();
    };

    // Only one panel at a time: opening the menu closes the search popup.
    document.addEventListener('gx-overlay', (event) => {
      if ((event as CustomEvent).detail !== 'search') close(false);
    });
    opener.addEventListener('click', () => (isOpen() ? close() : open()));
    closeButton.addEventListener('click', () => close());
    backdrop.addEventListener('pointerdown', () => close(false));
    window.addEventListener('resize', replace);
    window.addEventListener('scroll', replace, { passive: true });

    input.addEventListener('input', () => void run(input.value.trim()));
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        if (hits.length === 0) return;
        const step = event.key === 'ArrowDown' ? 1 : -1;
        setActive((active + step + hits.length) % hits.length);
      } else if (event.key === 'Enter') {
        event.preventDefault();
        const target = hits[active >= 0 ? active : 0];
        if (target) window.location.assign(target.url);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.preventDefault();
        close();
        return;
      }
      const typing = (event.target as HTMLElement | null)?.closest?.('input, textarea, select, [contenteditable="true"]');
      const shortcut = (event.key === 'k' || event.key === 'K') && (event.ctrlKey || event.metaKey);
      const slash = event.key === '/' && !event.ctrlKey && !event.metaKey && !event.altKey && !typing;
      if ((shortcut || slash) && !isOpen()) {
        event.preventDefault();
        open();
      }
    });
  }
</script>
