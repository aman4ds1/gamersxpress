---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'PC', href: '/category/pc' },
  { label: 'PlayStation', href: '/category/playstation' },
  { label: 'Xbox', href: '/category/xbox' },
  { label: 'Nintendo', href: '/category/nintendo' },
  { label: 'Hardware', href: '/category/hardware' },
  { label: 'Esports', href: '/category/esports' },
  { label: 'Tools', href: '/tools' },
];
---

<header class="border-b border-line bg-surface">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a
      href="/"
      class="text-xl font-extrabold tracking-tight text-ink-brand"
    >
      GamersXpress
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-medium">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-ink-muted transition-colors hover:text-ink-brand"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="relative md:hidden">
      <summary
        class="inline-flex cursor-pointer list-none items-center rounded-sm border border-line-strong px-3 py-1.5 text-sm font-medium text-ink-strong select-none [&::-webkit-details-marker]:hidden"
      >
        Menu
      </summary>
      <nav aria-label="Main mobile">
        <ul class="absolute right-0 z-20 mt-2 w-52 rounded-sm border border-line-elevated bg-surface-raised p-2 shadow-lg">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="block rounded-sm px-3 py-2 text-sm text-ink-strong hover:bg-surface-hover"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
