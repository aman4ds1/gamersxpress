---
/** A compact story beside the featured one: tinted with its category colour, picture on the right. */
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_COLORS, CATEGORY_LABELS, chipStyle } from '../data/categories';
import { cardImage, readingMinutes } from '../data/articles';
import Meta from './Meta.astro';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, pubDate, category } = article.data;
// Only the article's own picture: the category fallbacks carry a large label that would collide with the title.
const image = article.data.hero ? cardImage(article) : null;
---

<a href={`/news/${article.id}`} class="gx-side" style={`--tint:${CATEGORY_COLORS[category]}`}>
  {
    image && (
      <img class="gx-side-img" src={image.src} alt="" width={image.width} height={image.height} decoding="async" />
    )
  }
  <div class="gx-side-body">
    <span class="gx-chip" style={chipStyle(category)}>{CATEGORY_LABELS[category]}</span>
    <h3 class="gx-side-title">{title}</h3>
    <Meta date={pubDate} minutes={readingMinutes(article.body)} />
  </div>
</a>
